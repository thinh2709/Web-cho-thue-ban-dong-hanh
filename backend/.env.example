PORT=3001

# Chạy Node trực tiếp trên máy (MongoDB local):
MONGODB_URI=mongodb://127.0.0.1:27017/thue-ban-dong-hanh

# Tùy chọn: retry khi Mongo/DNS Docker chưa sẵn sàng (mặc định 15 lần, cách 2s)
# MONGODB_CONNECT_RETRIES=15
# MONGODB_CONNECT_RETRY_DELAY_MS=2000

# Docker Compose: KHÔNG cần copy các dòng trên vào .env để mount vào container.
# Trong docker-compose.yml service `app` đã set MONGODB_URI=mongodb://mongo:27017/...
# (hostname `mongo` = tên service trong compose; 127.0.0.1 trong container sẽ ECONNREFUSED).

# Chỉ chạy image (docker run), MongoDB trên máy host — Windows/Mac:
# MONGODB_URI=mongodb://host.docker.internal:27017/thue-ban-dong-hanh
